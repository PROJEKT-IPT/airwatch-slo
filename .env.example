# Database Configuration
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Backend Configuration
# For host-local backend + Docker database, use 127.0.0.1:5433.
# Docker Compose overrides these to db:5432 inside the backend container.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5433
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
# Backend URL the frontend calls (paths are <VITE_API_URL>/api/v1/...).
# Local dev uses frontend/.env.development (http://localhost:8000).
# In the production build, empty falls back to the deployed backend URL.
VITE_API_URL=

# Copernicus Configuration
COPERNICUS_USERNAME=
COPERNICUS_PASSWORD=
 
