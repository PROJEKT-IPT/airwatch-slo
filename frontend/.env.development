# Local development defaults (loaded only by `vite dev`, never by production build).
# Point the frontend at a locally running backend instead of the deployed
# Railway backend, so `npm run dev` does not silently read/write production data.
#
# Requires a local backend on :8000 (docker compose up backend, or
# `uvicorn main:app` in backend/). Override per developer in
# .env.development.local if your backend runs elsewhere.
VITE_API_URL=http://localhost:8000
